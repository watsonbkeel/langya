# 环境变量模板
# 用法：cp .env.example .env 后按实际情况修改
# ⚠️ .env 不入库（已在 .gitignore）

# ---- 服务端口 ----
# 必须监听 0.0.0.0，否则 Tailscale 网段访问不到
HOST=0.0.0.0
HTTP_PORT=8080
WS_PORT=8081
WS_PATH=/ws

# ---- 数据 ----
DB_PATH=./data/matches.sqlite

# ---- 日志 ----
LOG_LEVEL=info
LOG_DIR=./logs

# ---- 运行 ----
NODE_ENV=production

# ---- 调试开关（生产环境全部关闭）----
# 允许客户端请求调试信息（显示 AI 状态、路径点、命中判定框）
DEBUG_OVERLAY=false
# 加速时间步，用于本地快速验证一整局（1 = 正常速度）
TIME_SCALE=1
