{
  "name": "langyashan-server",
  "version": "0.1.0",
  "private": true,
  "description": "狼牙山五壮士权威游戏服务器",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js --external:ws --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.9",
    "pm2": "^7.0.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
